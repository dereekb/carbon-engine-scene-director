# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc
/.tmp
/packages/**/dist/*

# env
# do not publish secrets
.env.local*

# dependencies
/node_modules
**/node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
*.log
npm-debug.log*
yarn-error.log
testem.log
/typings
.stats/

# System Files
.DS_Store
Thumbs.db

# Angular build cache (apps/battle-console)
.angular

# scratch output (verify-page screenshots, experiments)
.scratch/

# saved scene files (user data; --scenes ./scenes)
/scenes/
# saved fleet compositions (user data; --fleets ./fleets). Anchored: packages/scene/src/lib/fleets is source.
/fleets/

# Claude
/.claude/settings.local.json
.claude/worktrees
.agents
scheduled_tasks.lock

# CI/Testing
.reports/
vitest.config.*.timestamp*

# Nx
.nx
.cache
.VSCodeCounter
