{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build-all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx run-many -t build",
        "color": true
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxfmt --write ."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxfmt --check ."
      }
    }
  }
}
